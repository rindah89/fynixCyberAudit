[Unit]
Description=Fynix CyberAudit encrypted backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/fynix-suite/cyberaudit/deploy/backup.sh /opt/fynix-suite/cyberaudit /var/backups/fynix/cyberaudit
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
