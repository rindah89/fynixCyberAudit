{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberaudit.fynixhq.com/contracts/cyberaudit-acceptance-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "origin", "contract_version", "company_id", "suite_tenant_id", "customer_id", "producer", "request_id", "target", "environment", "operation", "purpose", "operation_id", "support_sha", "devops_sha", "image_digest", "readiness_sha256", "emission_sha256", "itsm_binding_digest", "evidence_digest", "request_digest", "accepted", "observed_at", "requested_at", "reviewed_at", "issued_at", "expires_at", "consumed_at", "reviewer_id", "authority", "authority_binding_version", "authority_binding_verified_at", "authority_binding_digest", "key_id", "receipt_digest", "signature"],
  "properties": {
    "version": {"const": "fynix-cyberaudit-acceptance/v2"},
    "origin": {"const": "fynix-cyberaudit"},
    "contract_version": {"const": "fynix-cyberaudit-acceptance-request/v2"},
    "company_id": {"type": "integer", "minimum": 1},
    "suite_tenant_id": {"type": "string", "format": "uuid"},
    "customer_id": {"type": "string", "format": "uuid"},
    "producer": {"const": "fynix-support"},
    "request_id": {"type": "string", "format": "uuid"},
    "target": {"const": "fynix-devops-observability"},
    "environment": {"const": "production"},
    "operation": {"const": "activate-monitoring"},
    "purpose": {"enum": ["soak_start", "deploy"]},
    "operation_id": {"type": "string", "format": "uuid"},
    "support_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "devops_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "readiness_sha256": {"$ref": "#/$defs/digest"},
    "emission_sha256": {"$ref": "#/$defs/digest"},
    "itsm_binding_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "accepted": {"const": true},
    "observed_at": {"type": "string", "format": "date-time"},
    "requested_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "consumed_at": {"type": "string", "format": "date-time"},
    "reviewer_id": {"$ref": "#/$defs/digest"},
    "authority": {"const": "executive-hq"},
    "authority_binding_version": {"type": "integer", "minimum": 1},
    "authority_binding_verified_at": {"type": "string", "format": "date-time"},
    "authority_binding_digest": {"$ref": "#/$defs/digest"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
