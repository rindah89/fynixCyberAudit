# Copy to `.env` next to docker-compose.yml, then: docker compose up --build -d
# Compose reads these values. Do not commit `.env`.

APP_NAME="Fynix Cyber Audit"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8082
APP_PORT=8082

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fynixcyberaudit
DB_USERNAME=fynixcyberaudit
DB_PASSWORD=fynixcyberaudit
MYSQL_ROOT_PASSWORD=rootpassword

ADMIN_EMAIL=admin@campass.cm
ADMIN_PASSWORD=fynixdemo123!

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTHORIZE_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_SCOPES="openid email profile groups"
OIDC_AUTO_PROVISION=true
OIDC_ENFORCE_SSO_ONLY=false
OIDC_DEFAULT_ROLE="Regular User"

MODULE_AI_AUDIT_ENABLED=false
MODULE_SURVEYOR_ENABLED=false
MODULE_RISK_ASSESSOR_ENABLED=false
MODULE_REMEDIATION_ENABLED=false
MODULE_INCIDENTS_ENABLED=false

SUITE_PPM_ENABLED=false
SUITE_PPM_BASE_URL=
SUITE_PPM_TOKEN=
SUITE_PPM_TENANT_ID=
SUITE_PPM_WEBHOOK_ID=
SUITE_PPM_WEBHOOK_SECRETS=

# --- App Platform / production (do not use these values with local compose) ---
# DB_HOST=your-db-host.db.ondigitalocean.com
# DB_PORT=25060
# DB_SSL_MODE=require
# APP_URL=https://your-domain.com
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:YourGeneratedApplicationKeyHere
