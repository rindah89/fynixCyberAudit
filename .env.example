APP_NAME="Fynix Cyber Audit"

# First-run admin (Docker entrypoint / installer)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Docker Compose publish port
APP_PORT=8082
MYSQL_ROOT_PASSWORD=rootpassword

# Central OIDC (Fynix HQ) — same policy as PPM
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTHORIZE_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_SCOPES="openid email profile groups"
OIDC_AUTO_PROVISION=true
OIDC_ENFORCE_SSO_ONLY=false
OIDC_DEFAULT_ROLE="Regular User"

# Enterprise modules (default off)
MODULE_AI_AUDIT_ENABLED=false
MODULE_SURVEYOR_ENABLED=false
MODULE_RISK_ASSESSOR_ENABLED=false
MODULE_REMEDIATION_ENABLED=false
MODULE_INCIDENTS_ENABLED=false
MODULE_RESILIENCE_ENABLED=false
MODULE_COMPLIANCE_CASES_ENABLED=false
MODULE_PRIVACY_MANAGEMENT_ENABLED=false
MODULE_MODEL_RISK_MANAGEMENT_ENABLED=false
SURVEYOR_MAX_FILE_SIZE=10485760
SURVEYOR_MAX_BATCH_QUESTIONS=100
SURVEYOR_TIMEOUT_PER_QUESTION=120

# Fynix PPM (suite v2). Commands: REST. Signals: signed POST /api/suite/events
SUITE_PPM_ENABLED=false
SUITE_PPM_BASE_URL=
SUITE_PPM_TOKEN=
SUITE_PPM_TENANT_ID=
SUITE_PPM_WEBHOOK_ID=
SUITE_PPM_WEBHOOK_SECRETS=
SUITE_PPM_PUBLIC_URL=
SUITE_PPM_DEFAULT_WORK_TYPE_ID=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central error tracking (GlitchTip/Sentry-compatible)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TIMEOUT_SECONDS=2

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AUTO_START=true
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Configuration
# Provider: openai or digitalocean
AI_PROVIDER=openai
# Model: depends on provider (e.g., gpt-4.1-mini for OpenAI, alibaba-qwen3-32b for DigitalOcean)
AI_MODEL=

# AI API Keys (used as fallback when UI key is blank)
OPENAI_API_KEY=
DIGITALOCEAN_AI_KEY=

# Dedicated Support pre-mutation evidence acceptance. Secret paths must be
# absolute, regular non-symlink files with no group/other permissions.
CYBERAUDIT_EXECUTIVE_AUTHORITY_ORIGIN=https://fynixhq.com
CYBERAUDIT_EXECUTIVE_AUTHORITY_PUBLIC_KEYS_FILE=
CYBERAUDIT_CHANGE_REQUESTER_COMPANY_ID=
CYBERAUDIT_CHANGE_REQUESTER_KEY_FILE=
CYBERAUDIT_CHANGE_SIGNING_KEY_FILE=
CYBERAUDIT_CHANGE_SIGNING_KEY_ID=
CYBERAUDIT_CHANGE_SIGNING_PUBLIC_KEYS_FILE=
CYBERAUDIT_CHANGE_ACCEPTANCE_TTL_SECONDS=600

# AI Quota Settings (daily token limits, set to 0 to disable)
AI_PROMPT_QUOTA=1000000
AI_RESPONSE_QUOTA=1000000
